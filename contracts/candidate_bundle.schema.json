{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-swat.local/contracts/candidate_bundle.schema.json",
  "title": "CandidateBundleV1",
  "description": "Odpowiedź Supabase Edge Function swarm-candidates (RPC fn_swarm_candidate_bundle). Wyłącznie service-to-service po HMAC. coverage_mask: 32 znaki; znak na pozycji i (od lewej, 0-based) odpowiada wymiarowi i.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_eligible", "source", "candidates"],
  "properties": {
    "schema": { "type": "string", "const": "candidate-bundle-v1" },
    "source_eligible": { "type": "boolean" },
    "error": { "type": "string" },
    "source": { "$ref": "#/$defs/profile" },
    "candidates": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/candidate" } },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "desired_age_bands": { "type": "array", "items": { "type": "string" } },
        "max_region_scope": { "type": "string", "enum": ["same_city", "same_voivodeship", "same_country", "anywhere"] },
        "dealbreakers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intent_mismatch_hard": { "type": "boolean" },
            "longterm_plan_conflict_hard": { "type": "boolean" },
            "alcohol_mismatch_hard": { "type": "boolean" },
            "pets_mismatch_hard": { "type": "boolean" }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swarm_uid", "embedding", "coverage_mask", "coverage", "confidence"],
      "properties": {
        "swarm_uid": { "type": "string", "format": "uuid" },
        "vector_version": { "type": "string" },
        "embedding": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "number", "minimum": -1, "maximum": 1 } },
        "coverage_mask": { "type": "string", "pattern": "^[01]{32}$" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "region_code": { "type": ["string", "null"] },
        "age_band": { "type": ["string", "null"] },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swarm_uid", "embedding", "coverage_mask", "coverage", "confidence", "raw_similarity_ann", "overlap_dimensions"],
      "properties": {
        "swarm_uid": { "type": "string", "format": "uuid" },
        "embedding": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "number", "minimum": -1, "maximum": 1 } },
        "coverage_mask": { "type": "string", "pattern": "^[01]{32}$" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_similarity_ann": { "type": "number", "minimum": -1, "maximum": 1 },
        "overlap_dimensions": { "type": "integer", "minimum": 0, "maximum": 32 },
        "region_code": { "type": ["string", "null"] },
        "age_band": { "type": ["string", "null"] },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    }
  }
}
