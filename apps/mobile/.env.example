# Publiczne zmienne klienta. NIGDY nie wpisuj tu service_role, tokenu Abacus ani sekretów HMAC.
EXPO_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-key

# mock = deterministyczny adapter demonstracyjny; produkcyjne llama.rn wymaga dev-builda.
EXPO_PUBLIC_LOCAL_LLM=mock

# Tylko dev: dopasuj do ALLOW_UNSIGNED_EVIDENCE=true w sekretach lokalnego Supabase.
EXPO_PUBLIC_ALLOW_UNSIGNED_EVIDENCE=false
